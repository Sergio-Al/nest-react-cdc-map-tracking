VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000

# Optional raster XYZ tile overrides. Keep {z}/{x}/{y} placeholders in each URL.
# Set VITE_MAP_TILE_ATTRIBUTION to the tile provider's required HTML attribution
# whenever you override a URL. Vite exposes these values in the browser bundle.
# CARTO example (request a basemap key at https://carto.com/basemaps/apikey/):
# VITE_MAP_TILE_URL_DARK=https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILE_URL_LIGHT=https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://carto.com/attributions">CARTO</a> | &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
